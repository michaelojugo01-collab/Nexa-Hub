{
  "name": "nexa-hub",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nexa/mobile dev",
    "dev:client": "pnpm --filter @nexa/mobile dev:client",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "generate:api": "pnpm --filter @nexa/api-contract generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nexa/config": "workspace:*",
    "eslint-config-prettier": "^10.1.9",
    "prettier": "^3.10.1"
  }
}
