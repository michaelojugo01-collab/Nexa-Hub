# Public web (F3). Values here are not secret. Override in .env.local (gitignored).
# Read the shared mock data instead of the API.
USE_MOCKS=true
# Real API when USE_MOCKS=false.
API_URL=https://staging-api.nexahub.ng
# "mock": analytics events go to the browser console. Later: "posthog".
NEXT_PUBLIC_ANALYTICS=mock
