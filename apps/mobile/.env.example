# All app env vars. Defaults live in .env; override in .env.local (gitignored). EXPO_PUBLIC_* values are bundled
# into the app and are visible to anyone — never put secrets here.

# Answer API requests from src/mocks/fixtures instead of the network.
EXPO_PUBLIC_USE_MOCKS=true
# Artificial latency per mocked request (ms), to see loading states.
EXPO_PUBLIC_MOCK_DELAY_MS=800
# Share of mocked requests that fail with a 500 (0 to 1), to see error states.
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
# "default" or "empty" (every list comes back empty), to see empty states.
EXPO_PUBLIC_MOCK_SCENARIO=default

# Real API base URL, used when mocks are off.
EXPO_PUBLIC_API_URL=https://staging-api.nexahub.ng
