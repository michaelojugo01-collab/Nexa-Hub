# Local development defaults. NOT secret — EXPO_PUBLIC_* values are bundled into the app.
# Never put API keys or tokens in any .env file. Override locally in .env.local (gitignored).
# EAS builds set these per profile in eas.json.
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_MOCK_DELAY_MS=800
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
EXPO_PUBLIC_MOCK_SCENARIO=default
EXPO_PUBLIC_API_URL=https://staging-api.nexahub.ng
